{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Services",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "util.seo"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.accordion",
        "blocks.banner",
        "blocks.cards",
        "blocks.form-embed",
        "blocks.hero",
        "blocks.image-block",
        "blocks.image-gallery",
        "blocks.quote",
        "blocks.text-area",
        "blocks.video-embed",
        "blocks.text-and-image",
        "blocks.table",
        "blocks.buttons"
      ]
    },
    "price": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "dollar",
        "euro"
      ]
    },
    "service_type": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service-type.service-type",
      "mappedBy": "services"
    }
  }
}
